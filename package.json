{
  "name": "cogflow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n \"backend,frontend\" -c \"magenta,cyan\" \"npm run backend\" \"npm run frontend\"",
    "frontend": "vite",
    "backend": "node server/index.js",
    "train": "node server/ml/train.js",
    "models": "node server/ml/copyFaceModels.js && node server/ml/train.js",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "@vladmandic/face-api": "^1.7.15",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^1.43.0",
    "mongodb-memory-server": "^10.1.4",
    "mongoose": "^8.9.5",
    "multer": "^2.5.0",
    "pdf-parse": "^1.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^9.1.2",
    "oxlint": "^1.79.0",
    "vite": "^8.2.2"
  },
  "allowScripts": {
    "mongodb-memory-server@10.4.3": true
  }
}
