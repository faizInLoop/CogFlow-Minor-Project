# Copy to .env and replace placeholders. Never commit .env.
GROQ_API_KEY=your_groq_api_key
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
# Or provide multiple keys as a comma-separated list:
# GROQ_API_KEYS=your_first_key,your_second_key
GROQ_MODEL=openai/gpt-oss-120b

# Optional external MongoDB; without this, CogFlow tries local MongoDB,
# then starts a project-local embedded MongoDB instance.
# MONGODB_URI=mongodb://127.0.0.1:27017/cogflow
